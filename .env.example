# ===== Обязательные =====
# Адрес сайта (без слэша в конце). Используется в canonical, sitemap, ссылках из уведомлений.
NEXT_PUBLIC_SERVER_URL=https://getgeobit.ru
# Длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=
# База (в docker-compose хост — db)
POSTGRES_PASSWORD=
DATABASE_URI=postgres://geobit:${POSTGRES_PASSWORD}@db:5432/geobit
# Куда сохраняются загруженные картинки (том в docker-compose)
MEDIA_DIR=/app/media

# ===== Почта для заявок (российский SMTP: Яндекс 360, Mail.ru, Beget) =====
# Пример для Яндекса: smtp.yandex.ru:465, пароль приложения из настроек Яндекс ID
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Куда слать заявки, если в админке (Настройки сайта → Email для заявок) не указано
LEAD_EMAIL=info@getgeobit.ru

# ===== Уведомления в мессенджеры (без персональных данных: номер заявки + ссылка) =====
# Telegram: токен от @BotFather и ваш chat_id (узнать: написать боту @userinfobot)
TG_BOT_TOKEN=
TG_CHAT_ID=
# Если api.telegram.org не открывается с сервера — адрес своего Bot API-прокси
TG_API_BASE=
# MAX: токен бота из кабинета MAX для партнёров и id чата
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_BASE=https://platform-api.max.ru

# ===== Первый администратор (используется только скриптом seed) =====
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
